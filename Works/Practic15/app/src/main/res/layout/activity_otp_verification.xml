<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OtpVerification"
    android:paddingTop="100dp"
    android:paddingHorizontal="20dp">

    <TextView
        android:textColor="@color/black"
        android:id="@+id/first"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OTP Verification"
        style="@style/secondMainText"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/second"
        style="@style/secondSlaveText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/first"
        android:text="Enter the 6 digit numbers sent to your email"/>

    <com.otpview.OTPTextView
        android:layout_marginTop="50dp"
        android:id="@+id/otp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/black"
        app:otp_text_size="20sp"
        app:otp_box_background="@drawable/bg_otp_box"
        app:otp_box_background_active="@drawable/bg_otp_box_active"
        app:otp_box_background_inactive="@drawable/bg_otp_box_inactive"
        app:otp_box_background_error="@drawable/bg_otp_box_error"
        app:otp_box_background_success="@drawable/bg_otp_box_success"
        app:hide_otp_drawable="@drawable/bg_otp_box_hide"
        app:height="45dp"
        app:width="40dp"
        app:box_margin_left="10dp"
        app:box_margin_right="10dp"
        app:hide_otp="false"
        app:length="6"
        app:otp=""
        app:layout_constraintTop_toBottomOf="@+id/second"/>

    <TextView
        android:id="@+id/third"
        style="@style/secondSlaveText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@+id/otp"
        android:text="If you didn’t receive code, resend after 1:00"/>

    <com.google.android.material.button.MaterialButton
        android:layout_marginTop="50dp"
        android:backgroundTint="#A7A7A7"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set New Password"
        app:layout_constraintTop_toBottomOf="@+id/third" />

</androidx.constraintlayout.widget.ConstraintLayout>